# ─────────────────────────────────────────────────────────
#  Copie este arquivo para .env e preencha com seus valores
#  Nunca commite o .env no git
# ─────────────────────────────────────────────────────────

# Domínio da loja (sem https://)
SHOPIFY_STORE_DOMAIN=hmul0n-m9.myshopify.com

# App Shopify (Dev Dashboard) → Client ID e Client Secret
SHOPIFY_CLIENT_ID=cole_aqui_o_client_id
SHOPIFY_CLIENT_SECRET=cole_aqui_o_client_secret

# Admin API Access Token — obtido após rodar o fluxo OAuth (/auth)
# Preencha DEPOIS de completar o fluxo de autenticação
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxx

# URL de callback OAuth (URL do Netlify + caminho da function)
AUTH_CALLBACK_URL=https://SEU-SITE.netlify.app/.netlify/functions/auth-callback

# ID da coleção do combo (número da URL do admin)
SHOPIFY_COLLECTION_ID=000000000000

# Preço do combo em centavos  (9990 = R$99,90)
COMBO_PRICE_CENTS=9990

# Origem permitida para CORS (URL da loja Shopify)
ALLOWED_ORIGIN=https://hmul0n-m9.myshopify.com
